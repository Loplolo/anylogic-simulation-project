							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[for( int i=0; i < waitOrderProcessed.size(); i++){

		var order = waitOrderProcessed.get(i);

		if (order.quantity <= 0){
			// to avoid concurrency issues
			continue;
		}
				
	   	if (order.quantity > 0){
			order.quantity = order.quantity - 1;
			}
			
		if (order.quantity <= 0){
			waitOrderProcessed.free(order);
		}
		break;
}

enterShipping.take(agent);]]></Code>
							</Value>

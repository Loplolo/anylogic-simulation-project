			<AfterExperimentCode><![CDATA[String timeStamp = new java.text.SimpleDateFormat("yyyy-MM-dd_HH-mm-ss").format(new java.util.Date());

String fileName = "Results_" + timeStamp + ".csv";

outputExperiment.setFile(fileName, TextFile.WRITE);
outputExperiment.println("Indicator,Mean,Variance,Interval");

StatisticsDiscrete[] stats = { 
    cutterUtilization, 
    edgerUtilization, 
    washerUtilization, 
    pressUtilization, 
    autoclaveUtilization,
    transportersUtilization,
    leadTime,
    leadTimeReinf,
    throughput,
};

String[] names = { 
    "cutterUtilization", 
    "edgerUtilization", 
    "washerUtilization", 
    "pressUtilization", 
    "autoclaveUtilization",
    "transportersUtilization",
    "leadTime",
    "leadTimeReinf",
    "throughput",
};
    
for (int i = 0; i < stats.length; i++) {
    StatisticsDiscrete s = stats[i];
    String name = names[i];
    double mean = s.mean();    
    double variance = s.variance();
    double confidence = s.meanConfidence();
    outputExperiment.println(name + "," + mean + "," + variance + "," + confidence);
}

double mean = queueShippingSize.mean();    
double variance = queueShippingSize.variance();
double confidence = queueShippingSize.meanConfidence();
outputExperiment.println("queueShippingSize" + "," + mean + "," + variance + "," + confidence);

outputExperiment.close();]]></AfterExperimentCode>

						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[// Assumiamo il materiale grezzo gia` di dimensioni corrette
agent.quantity = uniform_discr(1, 20);

double minResWidth = 600;
double maxResWidth = 1200;

double minCommWidth = 400;
double maxCommWidth = 3100;

// Residenziale 60%
// Commerciale 30%
// Custom 10%
double u1 = random();

if (u1 < 0.50) {
    agent.width = triangular (minResWidth, (minResWidth+maxResWidth)/2, maxResWidth);
} else {
    agent.width = triangular (minCommWidth, (minCommWidth+maxCommWidth)/2, maxCommWidth);
}

// Aspect ratio delle finestre tra 1:1 and 1:2
double aspectRatio = uniform(1, 2.1);
agent.height = agent.width * aspectRatio;

// Complessita` della forma definita con un
// peso generico che segue sempre la stessa
// legge.
double u2 = random();
if ( u2 < 0.80) {
	agent.shapeComplexity = 1.0;
} else if (u2 < 0.15){
	agent.shapeComplexity = 1.25;
} else {
	agent.shapeComplexity = 1.5;
}

// Ordini che sono finestre reinforzate
agent.isReinforced = random() < 0.15;]]></Code>
							</Value>

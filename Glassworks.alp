					<Parameters>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[for( int i=0; i < waitOrderProcessedReinf.size(); i++){

		var order = waitOrderProcessedReinf.get(i);

		if (order.quantity <= 0){
			// to avoid concurrency issues
			continue;
		}
				
	   	if (order.quantity > 0){
			order.quantity = order.quantity - 1;
			}
			
		if (order.quantity <= 0){
			waitOrderProcessedReinf.free(order);
		}
		break;
}

enterShipping.take(agent);]]></Code>
							</Value>
						</Parameter>
